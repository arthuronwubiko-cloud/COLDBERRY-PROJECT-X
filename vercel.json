{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "romeos-project-x-admin.vercel.app"
        }
      ],
      "destination": "/admin",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "romeos-project-x-admin.vercel.app"
        }
      ],
      "destination": "/admin.html"
    },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin-console", "destination": "/admin.html" },
    { "source": "/manager", "destination": "/manager.html" },
    { "source": "/manager-console", "destination": "/manager.html" },
    { "source": "/feedback", "destination": "/feedback.html" },
    { "source": "/customer-feedback", "destination": "/feedback.html" },
    { "source": "/refunds", "destination": "/refunds.html" },
    { "source": "/refund-tokens", "destination": "/refunds.html" },
    { "source": "/driver", "destination": "/driver.html" },
    { "source": "/driver-console", "destination": "/driver.html" },
    { "source": "/track", "destination": "/track.html" },
    { "source": "/order", "destination": "/order.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/deals", "destination": "/pizzadeals.html" },
    { "source": "/menu", "destination": "/890b.html" }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/(admin|admin\\.html|admin-console|manager|manager\\.html|manager-console|driver|driver\\.html|driver-console|feedback|feedback\\.html|refunds|refunds\\.html|refund-tokens)(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    }
  ]
}
